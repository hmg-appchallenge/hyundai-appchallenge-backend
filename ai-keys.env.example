# 노래 생성 서버 키. 이 파일을 복사해서 이름을 ai-keys.env 로 바꾼 뒤 값만 채워요.
# ai-keys.env는 저장소에 올라가지 않아요. 키를 채팅이나 문서에 붙이지 마세요.

# 가사·제목 (Claude). https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# 반주·보컬 (ElevenLabs Music)
ELEVENLABS_API_KEY=

# 0이면 Claude·ElevenLabs로 만들고, 1이면 바깥을 부르지 않고 서버 안 엔진으로 만들어요
MOCK_GENERATION=0

# 앱이 바깥 주소로 붙을 때 쓰는 팀 키. 비워 두면 share-server.bat이 만들어 줘요
KR_API_KEY=
